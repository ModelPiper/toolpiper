{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.ModelPiper/toolpiper",
  "description": "300+ on-device MCP tools for macOS — local AI, voice, vision, browser automation, system control.",
  "version": "0.0.6-beta",
  "status": "active",
  "repository": {
    "url": "https://github.com/ModelPiper/toolpiper.git",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://modelpiper.com/press/toolpiper-icon.png",
      "mimeType": "image/png",
      "sizes": [
        "128x128"
      ]
    }
  ],
  "packages": [],
  "remotes": [],
  "websiteUrl": "https://modelpiper.com/toolpiper",
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "tools": "300+",
      "resources": 5,
      "prompts": 5,
      "categories": [
        "inference",
        "tts",
        "stt",
        "embeddings",
        "ocr",
        "vision",
        "nlp",
        "rag",
        "browser-automation",
        "testing",
        "system-actions",
        "video",
        "outreach",
        "model-management"
      ],
      "platform": "macOS",
      "transports": [
        "stdio",
        "streamable-http"
      ],
      "setup": "Install ToolPiper from https://modelpiper.com, then: claude mcp add --transport http toolpiper http://127.0.0.1:9998/mcp (or stdio: claude mcp add toolpiper -- ~/.toolpiper/mcp)"
    }
  }
}