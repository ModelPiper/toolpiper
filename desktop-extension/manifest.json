{
  "manifest_version": "0.3",
  "name": "toolpiper",
  "display_name": "ToolPiper",
  "version": "1.0.0",
  "description": "On-device MCP tools for macOS: local AI, speech, vision, browser automation, and system control, all running on your own Mac.",
  "long_description": "ToolPiper is a native macOS app that turns your Mac into a local AI platform: bundled inference on Metal and the Neural Engine, speech to text and text to speech, Apple Vision OCR and image analysis, Chrome automation over the accessibility tree, and native system control. This extension is a small forwarder: Claude Desktop launches it over stdio and it relays your requests to the ToolPiper already running on this Mac, over loopback. Nothing it sends leaves the machine.",
  "author": {
    "name": "Ben Racicot",
    "email": "bracicot@modelpiper.com",
    "url": "https://github.com/ModelPiper"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ModelPiper/toolpiper"
  },
  "homepage": "https://modelpiper.com/toolpiper",
  "documentation": "https://modelpiper.com/docs/toolpiper",
  "support": "https://github.com/ModelPiper/toolpiper/issues",
  "icon": "icon.png",
  "license": "MIT",
  "keywords": [
    "mcp",
    "macos",
    "local-ai",
    "on-device",
    "speech-to-text",
    "text-to-speech",
    "ocr",
    "browser-automation",
    "system-control"
  ],
  "privacy_policies": [
    "https://modelpiper.com/privacy"
  ],
  "server": {
    "type": "node",
    "entry_point": "server/index.js",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/server/index.js"
      ]
    }
  },
  "compatibility": {
    "platforms": [
      "darwin"
    ],
    "runtimes": {
      "node": ">=20.0.0"
    }
  },
